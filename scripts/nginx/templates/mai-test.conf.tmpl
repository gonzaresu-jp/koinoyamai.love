# staging: test.koinoyamai.love
# 導入: sudo cp /home/yuzuki/koinoyamai.love-test/scripts/nginx/mai-test.conf /etc/nginx/mai-test.conf
#       sudo sed -i '/^http {/a\    include /etc/nginx/mai-test.conf;' /etc/nginx/nginx.conf
#       sudo nginx -t && sudo systemctl reload nginx
# ※ /etc/nginx/nginx.conf は sites-enabled を include しないため http ブロック内へ直接 include する
server {
    listen 80;
    listen [::]:80;
    server_name test.koinoyamai.love;

    root /home/yuzuki/koinoyamai.love-test/webui;
    index index.php index.html;

    # Basic認証の代わりに、管理者セッション(adminToken cookie)でゲートをかける
    auth_request /_gate;
    error_page 401 =302 /admin/login/;

    # ログイン画面とその補助はゲート対象外（本番と同じ /admin/login/ エイリアス経由）
    location = /admin/login { return 301 /admin/login/; }
    location ^~ /admin/login/ {
        auth_request off;
        alias /home/yuzuki/koinoyamai.love-test/admin/;
        index login.html;
        try_files $uri $uri/ /login.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    include /etc/nginx/snippets/mai-security-headers.conf;
    }
    location = /admin/webauthn.js { auth_request off; }

    # ゲート本体（staging APIの /api/admin/verify で cookie認証）
    location = /_gate {
        internal;
        proxy_pass_request_body off;
        proxy_pass http://127.0.0.1:8081/api/admin/verify;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host test.koinoyamai.love;
        proxy_set_header X-Real-IP $remote_addr;
    }

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' https: data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # 静的アセット（FA/CSS/画像/スクリプト自体）は認証不要でも可（history.json等は認証のまま）
    location ~* \.(css|js|mjs|webp|png|jpg|jpeg|gif|svg|ico|woff2|woff|ttf)$ { auth_request off; }

    # API・SSE は staging API (:8081) へ（ゲート対象外: API側で独自にtoken認証）
    location /api/ {
        auth_request off;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;   # CF→nginxはhttpなのでCSRF判定用にhttpsを明示
        proxy_read_timeout 300s;
        proxy_buffering off;   # /api/events/stream (SSE) 用
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    include /etc/nginx/snippets/mai-security-headers.conf;
    }

    # 固定ページ（本番 nginx.conf.tmpl と同一の .php 抜き URL ルーティング）
    location = /info { return 301 /info/; }
    location /info/ {
        index info.php;
        try_files $uri $uri/ /info.php?$query_string;
    }

    location = /test { return 301 /test/; }
    location /test/ {
        index test.php;
        try_files $uri $uri/ /test.php?$query_string;
    }

    location = /logs { return 301 /logs/; }
    location /logs/ {
        index logs.php;
        try_files $uri $uri/ /logs.php?$query_string;
    }

    location = /download { return 301 /download/; }
    location /download/ {
        index download.php;
        try_files $uri $uri/ /download.php?$query_string;
    }

    location = /status { return 301 /status/; }
    location /status/ {
        index status.php;
        try_files $uri $uri/ /status.php?$query_string;
    }

    location = /future { return 301 /future/; }
    location /future/ {
        index future.php;
        try_files $uri $uri/ /future.php?$query_string;
    }

    location = /twitter-media { return 301 /twitter-media/; }
    location /twitter-media/ {
        index twitter-media.php;
        try_files $uri $uri/ /twitter-media.php?$query_string;
    }

    location = /archive { return 301 /archive/; }
    location /archive/ {
        index archive.php;
        try_files $uri $uri/ /archive.php?$query_string;
    }

    location = /guide { return 301 /guide/; }
    location /guide/ {
        index guide.php;
        try_files $uri $uri/ /guide.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
