# WebUI 配信
location /pushweb/ {
    alias /var/www/html/koinoyamai.love/webui/;
    index index.html;

    # 1. 実際の GET リクエストに対するヘッダー (OPTIONSが真でない場合)
    # GETリクエストに対するヘッダーをここにも追加し、ifの外には置かないようにします。
    if ($request_method = 'GET') {
        # PNAに必須のヘッダー
        add_header 'Access-Control-Allow-Private-Network' 'true';
        # 従来のCORSヘッダー
        add_header 'Access-Control-Allow-Origin' 'https://koinoyamai.love';
        # 静的ファイルに対してキャッシュ無効化（必要に応じて）
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # 2. PNAに必須のヘッダーを OPTIONS プリフライトリクエストに追加
    if ($request_method = 'OPTIONS') {
        # ⚠️ PNA対応の最重要ヘッダー
        add_header 'Access-Control-Allow-Private-Network' 'true'; 
        
        # 従来のCORSヘッダーもOPTIONSに応答するために必要
        add_header 'Access-Control-Allow-Origin' 'https://koinoyamai.love';
        add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS';
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Access-Control-Request-Private-Network';
        add_header 'Access-Control-Max-Age' 1728000;
        add_header 'Content-Type' 'text/plain; charset=UTF-8';
        add_header 'Content-Length' 0;
        return 204;
    }

    # ここにあった add_header は全て削除します。
}

