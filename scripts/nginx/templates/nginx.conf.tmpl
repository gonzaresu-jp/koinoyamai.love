user www-data;
worker_processes auto;

error_log /var/log/nginx/error.log;
pid /run/nginx.pid;

events {
    worker_connections 65535;
    multi_accept on;
    use epoll;
}

http {
    # tailnet 自動認証: tailscale serve は remote_addr=127.0.0.1 から着信する。
    # そのときだけ X-Tailnet-Admin に秘密値を立てる。Express は .env の
    # TAILNET_ADMIN_SECRET と一致するときのみ信頼する（他経路の値は不一致）。
    # tailnet 自動認証: tailscale serve (127.0.0.1) と tailnet 内の全端末を信頼する。
    geo $tailnet_admin {
        default             "";
        127.0.0.1           "${TAILNET_ADMIN_SECRET}";
        ::1                 "${TAILNET_ADMIN_SECRET}";
        100.64.0.0/10       "${TAILNET_ADMIN_SECRET}";
        fd7a:115c:a1e0::/48 "${TAILNET_ADMIN_SECRET}";
    }
    include /etc/nginx/mai-test.conf;
    include /etc/nginx/media.conf;
    include /etc/nginx/discord.conf;
    include mime.types;
    default_type application/octet-stream;
    log_format withff '$remote_addr real=$realip_remote_addr xff="$http_x_forwarded_for" cf="$http_cf_connecting_ip" "$request" $status';
    # honeypot-guard: ハニーポット用のログ（時刻・UA・クライアントIP 入り）
    # ※ 判定に使う固定フィールド（ip/cf/xff/st/uri/bytes）は **UA より前**に並べる。
    #   UA は攻撃者が自由に入れられるので、後ろに置いて解析を騙されないようにする。
    log_format honeyfmt '$time_iso8601 ip=$remote_addr cf=$http_cf_connecting_ip xff="$http_x_forwarded_for" st=$status uri=$uri bytes=$body_bytes_sent req="$request" ref="$http_referer" ua="$http_user_agent"';
access_log /var/log/nginx/access.log withff;

    error_log /var/log/nginx/error.log notice;   # debug だとリクエスト行（クエリ=共有シークレット）が平文で残る

    # 既出の is_discord_ua に加えて referer も判定
# http {} 直下で読み込まれるファイルに置く（※ server{} の外）
#map $http_user_agent $is_discord_ua {
#    default 0;
#    ~*Discordbot 1;
#    ~*Discord   1;
#}

#map $http_referer $is_discord_ref {
#    default 0;
#    "~*^https?://(canary\.|ptb\.)?discord(app)?\.com" 1;
#    "~*^https?://(cdn|media|images)\.discord(app)?\.(com|net)" 1;
#}

#map "$is_discord_ua$is_discord_ref" $discord_and_ok {
#    default 0;
#    "11" 1;  # UAもRefererもDiscord系のときOK
#}



    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 120;

    types_hash_max_size 2048;
    types_hash_bucket_size 128;
    open_file_cache max=100000 inactive=60s;
    # 静的ファイルを cp で置換した直後、古い size を保持したままだと
    # 応答が途中で切れてしまう（2026-09-26 の実デプロイで実際に発生）。
    # 120s -> 10s に短縮し、反映遅延を許容できる範囲に収める。
    open_file_cache_valid 10s;
    open_file_cache_min_uses 2;

    # 大きいアップロードも通す（server内にも置いてあるが、http直下にもセット）
    client_max_body_size 4G;
    client_body_buffer_size 64m;
 

	# HTTPサーバー
    server {
        client_max_body_size 4G;
	# SSL設定 (コメントアウト)

	 server_name ${TAILNET_HOSTNAME};
         
    # ---- 2026-09-13 漏えい遮断 ----
