    # -------------------
    location = /admin/login { return 301 /admin/login/; }
    location ^~ /admin/login/ {
        allow 192.168.0.0/16;
        allow 100.64.0.0/10;
        deny all;
        alias /var/www/html/koinoyamai.love/admin/;
        index login.html;
        try_files $uri $uri/ /login.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        error_page 403 = @to_elza_admin_login;
    include /etc/nginx/snippets/mai-security-headers.conf;
    }
    location @to_elza_admin_login {
        return 302 https://${TAILNET_HOSTNAME}/admin/login/;
    }

    # admin.html は Tailnet/LAN 直撃のみ。公開ドメインからは ts.net へ302、LAN はローカル配信
    location = /admin {
        allow 192.168.0.0/16;
        allow 100.64.0.0/10;
        deny all;
        root /var/www/html/koinoyamai.love/webui;
        try_files /admin.html =404;
        error_page 403 = @to_elza_admin;
    }
    location ^~ /admin.html {
        allow 192.168.0.0/16;
        allow 100.64.0.0/10;
        deny all;
        error_page 403 = @to_elza_admin;
    }
    location @to_elza_admin {
        return 302 https://${TAILNET_HOSTNAME}/admin.html;
    }

    # 管理APIは Tailnet/LAN 直撃のみ（公開ドメイン/CFトンネルからは403）
    location ^~ /api/admin {
        allow 192.168.0.0/16;
        allow 100.64.0.0/10;
        deny all;
        proxy_pass http://127.0.0.1:8080;
        proxy_connect_timeout 30s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $http_host;
        add_header Cache-Control "no-store" always;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # -------------------
    # service-worker.js
    # -------------------
location = /service-worker.js {
    root /var/www/html/koinoyamai.love/webui;
    try_files /service-worker.js =404;

    default_type application/javascript;
    add_header Content-Type application/javascript;

    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    add_header Service-Worker-Allowed "/" always;
    include /etc/nginx/snippets/mai-security-headers.conf;
}

location = /history.json {
    root /var/www/html/koinoyamai.love/webui;
    default_type application/json;
    try_files $uri =404;

    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
    include /etc/nginx/snippets/mai-security-headers.conf;
}

    # -------------------
    # エラーページ
    # -------------------
    error_page 500 502 503 504 /50x.html;
    error_page 404 /404.html;

    location = /50x.html { root /usr/share/nginx/html; }
    location = /404.html { root /usr/share/nginx/html; }

    # ポート混入防止
    port_in_redirect off;
    absolute_redirect off;

    location = /display {
        return 301 /display/;
    }

    location ^~ /display/ {
        alias /var/www/html/smart-display/;
        index display.html;
        autoindex off;
        # キャッシュ無効（add_header ではなく expires を使う）。
        # add_header を 1 つでも書くと server レベルの CSP 等を継承しなくなるため（AGENTS.md §11）。
        # HTML は固定名 display.html で、中の JS/CSS は hashed 名。
        # キャッシュされた HTML が旧 hashed アセットを要求すると真っ白になるため必ず無効化する。
        expires -1;
    }
}
}
