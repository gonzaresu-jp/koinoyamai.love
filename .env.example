# ============================================================
# 環境変数サンプル（.env.example → .env にコピーして使う）
#
# 運用ルール（AGENTS.md §3 / §6.5）
#   - 値は「環境ごとに別々」にする（本番 / staging で使い回さない）
#   - 秘密（*_SECRET / *_TOKEN / *_KEY / *_PASSWORD / *_HASH）は
#     `openssl rand -hex 32` などで環境ごとに生成する
#   - .env は gitignore 済み（コミットしない）
#   - 同じキーを二重に書かない（先頭勝ちで後の値が無効化される）
#
# ★ 値は「安全な側（staging 相当）」で書いてある。コピーして使うときは
#   本番 environment では次の 4 つを必ず変更する（§1・§2）:
#     NODE_ENV=production / PORT=8080 / DISABLE_NOTIFICATIONS=0
#     NOTIFY_API_URL=http://127.0.0.1:8080/api/notify
#   逆に staging ではこの 4 つを**変更しない**こと
#   （DISABLE_NOTIFICATIONS=1 は実送抑止。0 にすると本番ユーザーへ通知が飛ぶ）
#
# ここに無いキー（機能ごとの任意設定・AI系・圧報等）は
#   grep -rhoE 'process\.env\.[A-Z0-9_]+' --include='*.js' --exclude-dir=node_modules .
# で全キーを確認できる。docs/ARCHITECTURE.md §6 も参照。
# ============================================================

# ---------- 公開設定 ----------
PUBLIC_URL=https://mai.example.com
# 管理APIの IP 判定で X-Forwarded-For を信頼するか（Express の trust proxy は
#  server.js で "loopback" 固定。このキーは lib/admin.js の getClientIP() のみで使う）
TRUST_PROXY=false
COOKIE_SECURE=true
TZ=Asia/Tokyo

# ---------- 通知 API（token + HMAC v2 + timestamp）----------
# 送信側は必ず src/core/notify-sign.js の signNotifyPayload を使う
NOTIFY_API_URL=http://127.0.0.1:8081/api/notify
NOTIFY_API_TOKEN=replace-with-notify-token-64-random-chars
NOTIFY_HMAC_SECRET=replace-with-notify-hmac-secret-64-random-chars
# 内部 API（scraper-status 等）
INTERNAL_API_TOKEN=replace-with-internal-token-64-random-chars

# ---------- ユーザー認証（OAuth / JWT）----------
JWT_SECRET=replace-with-jwt-secret-64-random-chars
SESSION_SECRET=replace-with-session-secret-64-random-chars
JWT_EXPIRES_IN=30d
AUTH_COOKIE_NAME=session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mai.example.com/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://mai.example.com/auth/discord/callback

# ---------- 管理者 ----------
ADMIN_USERNAME=admin
# 空のままにする（未設定＝fail-closed。値を入れると bcrypt 比較で例外になる）
ADMIN_PASSWORD_HASH=
# 管理APIを許可する IP リスト（空＝制限なし。空以下の環境では設定すること）
ALLOWED_IPS=
# Tailnet 経由の自動認証に使う秘密（nginx の $tailnet_admin と同一値・§6.7）
TAILNET_ADMIN_SECRET=
# パスキー（WebAuthn）。RP ID / Origin はドメインごとに別
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID_EXTRA=
WEBAUTHN_ORIGIN_EXTRA=
# 移行期・テスト用の別 RP
WEBAUTHN_RP_ID_TEST=
WEBAUTHN_ORIGIN_TEST=
WEBAUTHN_RP_ID_NEW=
WEBAUTHN_ORIGIN_NEW=

# ---------- DB / 実行モード ----------
# 管理者用の DB パス（未設定なら通常 DB が使われる）
ADMIN_DB_PATH=
NODE_ENV=development
PORT=8081
DB_FILE_NAME=data.db
# 通知の実送抑止。staging は 1 固定（実送抑止・履歴のみ）。0 に戻さないこと（§2）
DISABLE_NOTIFICATIONS=1

# ---------- YouTube ----------
# 監視対象チャンネルは src/scrapers/youtube.js の CHANNEL_IDS
# 週間スケジュール取得（weekly/youtube.js）が使うチャンネル
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
YT_WEBHOOK_PORT=3001
# PubSubHubbub の callback 保護用シークレット（AGENTS.md §6.8）
# hub は callback URL に token クエリを保持したまま hub.mode 等を追記する。
# 未設定なら webhook は fail-closed（403）＝購読できない。
YOUTUBE_WEBHOOK_TOKEN=replace-with-a-random-token

# ---------- Push（FCM / Android）----------
# VAPID 鍵はファイル vapid.json（gitignore 済み・.env ではない）
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=

# ---------- RAG / 埋め込み / ベクトルDB ----------
RAG_CHAT_PROVIDER=
# 未設定時の既定値は 8081（= staging ポート）。本番では必ず明示する
RAG_CHAT_ENDPOINT=
RAG_CHAT_MODEL=
RAG_TOPK=6
RAG_TEMPERATURE=0.7
EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=
EMBEDDING_DIM=384
# 既定は qdrant。simple は pi-vector-service（:6333）が必要
VECTOR_DB_BACKEND=simple
VECTOR_DB_URL=http://127.0.0.1:6333
VECTOR_DB_COLLECTION=
KNOWLEDGE_FILE=rag-knowledge.json
RAG_PERSONALITY_FILE=rag-personality.json

# ---------- チャット読み上げ（TTS）----------
CHAT_TTS_PROVIDER=
CHAT_TTS_URL=
CHAT_TTS_VOICE=
CHAT_TTS_NUM_STEPS=2
CHAT_TTS_API_KEY=
CHAT_TTS_AIVIS_URL=
CHAT_TTS_AIVIS_SPEAKER=
CHAT_TTS_AIVIS_INTONATION=

# ---------- 要約（minutes）----------
MINUTES_API_URL=
MINUTES_API_KEY=
MINUTES_MODEL=
MINUTES_GROQ_URL=
MINUTES_GROQ_MODEL=

# ---------- 解析 AI（予定抽出・ツイート解析）----------
TWITTER_AI_URL=
TWITTER_AI_MODEL=
TWITTER_AI_FALLBACK_URL=
TWITTER_AI_FALLBACK_MODEL=
TWITTER_AI_FALLBACK_KEY=
GEMINI_API_KEY=
GEMINI_URL=

# ---------- Discord Bot ----------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ---------- 運用調整（既定値で運用，除非変更時のみ）----------
SSE_MAX_CLIENTS=500
SSE_HEARTBEAT_MS=25000
NOTIFY_CONCURRENCY=20
