<Window
    x:Class="MaiPushWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MaiPushWinUI"
    Title="まいちゃん通知">

    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:HandTabView
            Grid.Row="0"
            x:Name="Tabs"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested"
            TabDroppedOutside="Tabs_TabDroppedOutside"
            SelectionChanged="Tabs_SelectionChanged"
            KeyDown="Tabs_KeyDown"
            Loaded="Tabs_Loaded"
            CanReorderTabs="True"
            CanDragTabs="True"
            VerticalAlignment="Top">

            <local:HandTabView.TabStripHeader>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" IsHitTestVisible="False"/>
                    <Button Click="ReloadButton_Click"
                            Width="40" Height="40"
                            Padding="0"
                            ToolTipService.ToolTip="再読み込み">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#c42589"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#9a1a6c"/>
                            <SolidColorBrush x:Key="ButtonForeground"             Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="White"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent"/>
                        </Button.Resources>
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </local:HandTabView.TabStripHeader>

            <local:HandTabView.TabStripFooter>
                <Border x:Name="CaptionPadding" IsHitTestVisible="False"/>
            </local:HandTabView.TabStripFooter>
        </local:HandTabView>

        <Grid Grid.Row="1" x:Name="ContentGrid"/>
    </Grid>
</Window>
