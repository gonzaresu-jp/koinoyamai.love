<Project Sdk="Microsoft.NET.Sdk">
  <!-- WebView2Loader.dll はネットワークドライブから読めないため常にローカルへ出力 -->
  <PropertyGroup>
    <BaseOutputPath>$(LOCALAPPDATA)\MaiPushWinUI\</BaseOutputPath>
    <!-- dotnet publish もローカルドライブへ出力（ネットワーク共有では WebView2 が起動不可） -->
    <PublishDir>$(LOCALAPPDATA)\MaiPushWinUI\publish\</PublishDir>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MaiPushWinUI</RootNamespace>
    <AssemblyName>まいちゃん通知</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- self-contained publish で 0xc000027b クラッシュする既知問題の対策（必須） -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.8.6</Version>
    <!-- Release publish はランタイム同梱（self-contained）。インストール先に .NET
         ランタイムが無くても起動するようにする。「No frameworks were found」事故対策 -->
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <Product>まいちゃん通知</Product>
    <AssemblyTitle>まいちゃん通知</AssemblyTitle>
    <!-- SourceLink 無効（CI 外でのビルド用） -->
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 安定版（インストール済みランタイムと合わせる） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- WebView2（WinUI3 ビルトインだが CoreWebView2 API のため参照） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- システムトレイ -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
